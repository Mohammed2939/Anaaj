# Copy to .env.local to upload optimized assets to your Vercel Blob store
# Create a Store in Vercel Dashboard -> Storage -> Blob -> Copy Read/Write Token
BLOB_READ_WRITE_TOKEN=

# Optional: override base URL if using custom Blob domain without src/blobManifest.json
# VITE_BLOB_BASE_URL=https://your-store-id.public.blob.vercel-storage.com
